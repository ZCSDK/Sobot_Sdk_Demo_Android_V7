<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏上传附件按钮专用背景（走查 #4：竖屏按钮白底与虚线区背景同色看着像透明）。
  横屏描边用 sobot_color_line_divider(#EBEBEB 日间 / 暗夜自动切换) 增强对比度；
  竖屏仍走 sobot_dialog_bg_line_6.xml，互不影响。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <!-- 白色底（暗夜模式由 sobot_color_bg_first 自动切换为深底） -->
            <solid android:color="@color/sobot_color_bg_first" />

            <stroke android:width="1dp" android:color="@color/sobot_color_line_divider" />

            <corners android:radius="6dp" />
        </shape>
    </item>

</selector>
