<?xml version="1.0" encoding="utf-8"?>
<!--
  留言详情 inline 回复栏 36dp 小圆按钮 selector（📎 附件 / ✕ 关闭）。

  规格（Figma）：不带阴影，只留边框 —— 白底 + 1dp #D9D9D9 描边。
  宿主 View 不设 elevation / outlineProvider，保持纯平面样式；
  不要与带阴影的 sobot_bg_side_btn_default.xml 混用。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 按下状态：浅灰按压底 + 1dp 描边 -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/sobot_ticket_item_press" />
            <stroke
                android:width="1dp"
                android:color="@color/sobot_color_line_divider" />
        </shape>
    </item>

    <!-- 默认状态：白底 + 1dp 描边，无阴影 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/sobot_color_dialog_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/sobot_color_line_divider" />
        </shape>
    </item>

</selector>
