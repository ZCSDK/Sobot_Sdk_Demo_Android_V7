<?xml version="1.0" encoding="utf-8"?>
<!--
  文件预览页 横屏专用布局（w >= 600dp，走查新增档）。
  与竖屏差异：
  - 上部内容（图标/文件名/大小）在剩余空间垂直居中，不整体下坠
  - 底部操作区（按钮/进度条/描述）固定距屏幕底 48dp（走查规格）
  按钮（下载/打开）固定 264dp × 36dp 水平居中，横竖屏规格一致。
  View ID 与竖屏保持一致，SobotFileDetailActivity 业务逻辑零改动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sobot_color_bg_first"
    android:orientation="vertical">

    <include layout="@layout/sobot_layout_common_titlebar" />

    <!-- 上部内容区：weight=1 + gravity=center，图标/文件名/大小垂直居中 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <com.sobot.chat.widget.SobotSectorProgressView
            android:id="@+id/sobot_file_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="30dp"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/sobot_file_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:textColor="@color/sobot_color_text_first"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/sobot_ll_file_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sobot_tv_file_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sobot_color_text_second"
                android:textSize="@dimen/sobot_text_font_14"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/sobot_tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/sobot_color_text_second"
                android:textSize="@dimen/sobot_text_font_14"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部操作区：距屏幕底 48dp（走查规格）；按钮与进度条/描述按下载状态互斥显隐 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <!-- 下载/打开按钮：固定 264dp × 36dp 水平居中，横竖屏规格一致 -->
        <TextView
            android:id="@+id/sobot_btn_start"
            android:layout_width="264dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/sobot_bg_theme_color_22dp"
            android:gravity="center"
            android:textColor="@drawable/sobot_btn_text_selector"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/sobot_ll_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/sobot_pb_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:progressDrawable="@drawable/sobot_progressbar_preview" />

            <TextView
                android:id="@+id/sobot_btn_cancel"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:background="@drawable/sobot_icon_remove" />
        </LinearLayout>

        <TextView
            android:id="@+id/sobot_tv_decribe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="9dp"
            android:textColor="@color/sobot_color_text_second"
            android:textSize="@dimen/sobot_text_font_14"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
